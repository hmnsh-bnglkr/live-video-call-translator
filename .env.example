# LibreTranslate endpoint (free/self-hostable)
# Recommended: run LibreTranslate locally and point this to it:
#   http://localhost:5000/translate
# Or use a public instance (may be rate-limited/unreliable):
#   https://libretranslate.de/translate
LIBRETRANSLATE_URL=https://libretranslate.de/translate

# Optional: some instances require an API key
LIBRETRANSLATE_API_KEY=

# Port for the FastAPI server (optional, defaults to 3000)
PORT=3000

# Optional Whisper settings for the /transcribe endpoint
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_BACKEND=auto
